{
  "name": "quitfree-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for QuitFree",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "node --experimental-vm-modules node_modules/typescript/bin/tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
