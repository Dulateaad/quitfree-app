  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
